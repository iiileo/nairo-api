# 复制为 .env 后修改。切勿把 .env 提交到 Git。
# 生产环境（SERVER_MODE=prod）必须更换所有 *-change-me / 弱口令。

SERVER_ADDRESS=:8088
SERVER_MODE=local
# prod 时必填强密钥（≥16）；local 可空（密钥明文兼容存，仅开发）
SECURITY_MASTER_KEY=
# 逗号分隔；空则 local 放宽、prod 仅允许无 Origin（原生 App）
SERVER_ALLOWED_ORIGINS=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DBNAME=nairo_app

LOGGING_LEVEL=debug
WEB_DEV=true
# 管理后台 URL 前缀，建议自行修改降低扫目录风险（非安全边界）
WEB_ADMIN_BASE_PATH=/admin_nairo

SNOWFLAKE_NODE_ID=1
# 收银台 / 回调对外根地址；生产必须为 https://你的域名
PAY_PUBLIC_BASE_URL=http://127.0.0.1:8088
PAY_LOCK_TTL_SECONDS=300

# ---- 以下为开发占位，生产务必改为长随机串 ----
ADMIN_JWT_SECRET=nairo-dev-secret-change-me
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123
CONSOLE_JWT_SECRET=nairo-console-dev-secret-change-me
CONSOLE_ACCESS_TTL_SECONDS=900
CONSOLE_REFRESH_TTL_SECONDS=604800
CONSOLE_DEFAULT_FEE_RATE_BPS=100
CONSOLE_CODE_TTL_SECONDS=600
# 是否开放商户自助注册（也可在管理后台热更新）
CONSOLE_REGISTER_ENABLED=true
# prod 默认应 false；local 为 true 时会种子演示商户 user01/user01
CONSOLE_BOOTSTRAP_DEMO=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# prod 必须 false 并配置真实 SMTP
SMTP_DEV_PRINT=true

# 极验 GT4：同时配置 ID+Key 后，注册发码需过人机验证（也可在管理后台热更新）
GEETEST_CAPTCHA_ID=
GEETEST_CAPTCHA_KEY=
